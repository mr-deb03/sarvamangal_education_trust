# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this deployment — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sarvamangaleducationtrust.org

# ── Payload CMS (admin at /admin, same app) ─────────────────
# Postgres in production:  postgres://USER:PASSWORD@HOST:5432/sarvamangal
# Local dev without Postgres: file:./sarvamangal-local.db  (SQLite)
# Leave empty to run the site on the built-in seed content (no /admin).
DATABASE_URI=
# Long random string; signs admin logins. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ── SEO & analytics (optional) ──────────────────────────────
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
