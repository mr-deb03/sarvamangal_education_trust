# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this deployment — used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sarvamangaleducationtrust.org

# ── Sanity CMS ──────────────────────────────────────────────
# Leave SANITY_PROJECT_ID empty to run on the seed content in src/lib/cms/seed.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2025-10-01
# Only needed if the dataset is private (Viewer token from sanity.io/manage → API → Tokens).
SANITY_READ_TOKEN=
# Shared secret for the publish webhook → /api/revalidate. Any long random string.
SANITY_REVALIDATE_SECRET=

# ── SEO & analytics (optional) ──────────────────────────────
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
